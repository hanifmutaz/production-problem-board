# Opsi 1: pakai connection string langsung (paling gampang, cocok buat Supabase/Neon/Railway/dsb)
DATABASE_URL=postgresql://user:password@localhost:5432/ppcb

# Opsi 2: kalau DATABASE_URL kosong, pakai variabel di bawah ini satu-satu
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=ppcb

# Set "true" kalau host Postgres-nya butuh SSL (biasanya provider cloud)
PGSSL=false

PORT=6000
